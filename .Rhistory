)
library(seasonal)
desaiso <- function(country_list) {
diagnose_sheet <- function(df) {
numeric_cols <- df[sapply(df, is.numeric)]
as.data.frame(lapply(numeric_cols, function(x) {
if (all(is.na(x)) || sum(!is.na(x)) < 24) return(rep(NA, length(x)))
idx <- which(!is.na(x))
x_sub <- x[min(idx):max(idx)]
if (any(is.na(x_sub))) return(rep(NA, length(x)))
sa_sub <- tryCatch(
as.numeric(final(seas(ts(x_sub, frequency = 12)))),
error = function(e) rep(NA, length(x_sub))
)
res <- rep(NA, length(x))
res[min(idx):max(idx)] <- sa_sub
res
}))
}
list(
Revenues = diagnose_sheet(country_list$Revenues),
Expenditures = diagnose_sheet(country_list$Expenditures)
)
}
data_desaiso <- lapply(countries, desaiso)
mapply(plot_country_pdf,
country_data = countries,
country_stat = data_desaiso,
country_name = names(countries))
