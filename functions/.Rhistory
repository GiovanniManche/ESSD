# Affichage des rotations et niveau de troncature
cat("Rotations permises:", if(x$rotations_used) "Oui" else "Non", "\n")
cat("Niveau de troncature:",
if(is.null(x$trunc_level) || identical(x$trunc_level, Inf)) "Aucun" else x$trunc_level,
"\n\n")
# Affichage du résumé si disponible
if (!is.null(x$summary)) {
cat("Résumé de la structure:\n")
print(x$summary)
# Affichage de la valeur du critère de sélection
if (!is.null(x$criterion_value) && !is.na(x$criterion_value)) {
cat("\nValeur du critère de sélection:", x$criterion_value, "\n")
}
}
# Retourne NULL de manière invisible (convention pour les fonctions print)
invisible(NULL)
}
# Simulation à partir d'un modèle de copule vine
# Cette fonction génère des échantillons aléatoires (pseudo-observations)
# à partir d'un modèle de copule vine préalablement ajusté.
# Paramètres :
# model : objet rvine_fit
# n : nombre d'observations à simuler
# seeds : seed classique pour reproductibilité
simulate_rvine <- function(model, n, seeds = NULL, qrng = FALSE, cores = 1) {
# Vérification du type d'objet
if (!inherits(model, "rvine_fit")) {
stop("'model' doit être un objet de classe 'rvine_fit'")
}
# Fixation de la graine si spécifiée (pour reproductibilité)
if (!is.null(seeds)) {
set.seed(seeds)
}
# Simulation à partir du modèle
sims <- rvinecopulib::rvinecop(n, model$model, qrng = qrng, cores = cores)
return(sims)
}
count_families <- function(vine_model) {
families <- unlist(lapply(vine_model$model$pair_copulas, function(tree) {
sapply(tree, function(cop) cop$family)
}))
fam_table <- table(families)
list(
total_pairs = length(families),
distinct_families = names(fam_table),
count_by_family = fam_table
)
}
exemple_complet_rvine <- function() {
# 1. Générer des données synthétiques
set.seed(1234)
n <- 1000  # Nombre d'observations
d <- 4     # Nombre de dimensions
# Générer des données avec structure de dépendance
X1 <- rnorm(n)
X2 <- 0.7 * X1 + rnorm(n, 0, sqrt(1 - 0.7^2))  # Corrélation avec X1
X3 <- 0.3 * X1 + 0.5 * X2 + rnorm(n, 0, sqrt(1 - 0.3^2 - 0.5^2))  # Dépendance multiple
X4 <- exp(0.4 * X2) * rnorm(n)  # Dépendance non-linéaire
# Transformer en pseudo-observations (entre 0 et 1)
u1 <- pnorm(X1)
u2 <- pnorm(X2)
u3 <- pnorm(X3)
u4 <- pnorm(X4)
data <- cbind(u1, u2, u3, u4)
colnames(data) <- c("u1", "u2", "u3", "u4")
# 2. Ajuster différents modèles de copules
cat("Ajustement de modèles de copules vine...\n")
# R-vine (structure apprise automatiquement)
model_rvine <- fit_rvine(data, type = "rvine")
# C-vine (structure en étoile avec la première variable comme pivot)
model_cvine <- fit_rvine(data, type = "cvine")
# D-vine (structure en chaîne)
model_dvine <- fit_rvine(data, type = "dvine")
# R-vine avec copule Clayton uniquement
model_clayton <- fit_rvine(data, type = "rvine", families = "clayton")
# R-vine avec copule Student uniquement
model_student <- fit_rvine(data, type = "rvine", families = "t")
# AJOUT: Modèles avec sélection automatique du niveau de troncature
cat("\nAjustement de modèles avec sélection automatique du niveau de troncature...\n")
# R-vine avec troncature automatique via mBICV
model_rvine_auto_trunc <- fit_rvine(data, type = "rvine",
families = c("joe"),
trunc_lvl = NA,
selection_criterion = "mbicv")
# R-vine mixte (plusieurs familles) avec troncature automatique via mBICV
model_mixed_auto_trunc <- fit_rvine(data, type = "rvine",
families = c("clayton", "t", "gumbel", "frank"),
trunc_lvl = NA,
selection_criterion = "mbicv")
# D-vine avec troncature automatique via mBICV
model_dvine_auto_trunc <- fit_rvine(data, type = "dvine",
trunc_lvl = NA,
selection_criterion = "mbicv")
# 3. Comparer les modèles
cat("\nComparaison des critères de sélection (AIC/mBICV):\n")
criteria <- c(
Rvine = model_rvine$criterion_value,
Cvine = model_cvine$criterion_value,
Dvine = model_dvine$criterion_value,
Clayton = model_clayton$criterion_value,
Student = model_student$criterion_value,
Rvine_AutoTrunc = model_rvine_auto_trunc$criterion_value,
Mixed_AutoTrunc = model_mixed_auto_trunc$criterion_value,
Dvine_AutoTrunc = model_dvine_auto_trunc$criterion_value
)
# Trier et afficher les critères
sorted_criteria <- sort(criteria)
print(sorted_criteria)
cat("\nNiveaux de troncature sélectionnés automatiquement:\n")
trunc_levels <- c(
Rvine_AutoTrunc  = if (!is.null(model_rvine_auto_trunc$trunc_level)) model_rvine_auto_trunc$trunc_level else NA,
Mixed_AutoTrunc  = if (!is.null(model_mixed_auto_trunc$trunc_level)) model_mixed_auto_trunc$trunc_level else NA,
Dvine_AutoTrunc  = if (!is.null(model_dvine_auto_trunc$trunc_level)) model_dvine_auto_trunc$trunc_level else NA
)
print(trunc_levels)
cat("\nRépartition des familles de copules dans les modèles à troncature automatique :\n")
fam_rvine  <- count_families(model_rvine_auto_trunc)
fam_mixed  <- count_families(model_mixed_auto_trunc)
fam_dvine  <- count_families(model_dvine_auto_trunc)
cat("\nRvine_AutoTrunc :\n")
print(fam_rvine$count_by_family)
cat("\nMixed_AutoTrunc :\n")
print(fam_mixed$count_by_family)
cat("\nDvine_AutoTrunc :\n")
print(fam_dvine$count_by_family)
# Sélectionner le meilleur modèle (critère le plus bas)
best_model_name <- names(sorted_criteria)[1]
cat("\nLe meilleur modèle est:", best_model_name, "\n")
# Récupérer le meilleur modèle
best_model <- switch(best_model_name,
Rvine = model_rvine,
Cvine = model_cvine,
Dvine = model_dvine,
Clayton = model_clayton,
Student = model_student,
Rvine_AutoTrunc = model_rvine_auto_trunc,
Mixed_AutoTrunc = model_mixed_auto_trunc,
Dvine_AutoTrunc = model_dvine_auto_trunc)
# 4. Simuler à partir du meilleur modèle
cat("\nSimulation à partir du meilleur modèle...\n")
simulated_data <- simulate_rvine(best_model, n = 1000, seeds = 456)
# 5. Visualisation
if (requireNamespace("ggplot2", quietly = TRUE) &&
requireNamespace("GGally", quietly = TRUE)) {
cat("\nCréation de graphiques de comparaison...\n")
library(ggplot2)
library(GGally)
# Convertir les données en data.frame pour ggplot
real_df <- as.data.frame(data)
sim_df <- as.data.frame(simulated_data)
# Créer les graphiques
p1 <- ggpairs(real_df, title = "Données originales")
p2 <- ggpairs(sim_df, title = "Données simulées")
# Afficher les graphiques
print(p1)
print(p2)
cat("\nLes graphiques montrent la comparaison entre les données originales et simulées.\n")
} else {
cat("\nPour visualiser les résultats, installez les packages 'ggplot2' et 'GGally'.\n")
# Alternative avec pairs de base R
par(mfrow = c(1, 2))
pairs(data, main = "Données originales")
pairs(simulated_data, main = "Données simulées")
par(mfrow = c(1, 1))
}
# Analyser la structure du meilleur modèle
if (grepl("AutoTrunc", best_model_name)) {
cat("\nAnalyse détaillée du meilleur modèle (avec troncature automatique):\n")
cat("Niveau de troncature sélectionné:", trunc_levels[best_model_name], "\n")
# Afficher les familles sélectionnées si disponible
if (!is.null(best_model$summary)) {
cat("\nFamilles de copules sélectionnées:\n")
print(best_model$summary)
}
}
# Retourner les résultats
return(list(
original_data = data,
models = list(
rvine = model_rvine,
cvine = model_cvine,
dvine = model_dvine,
clayton = model_clayton,
student = model_student,
rvine_auto_trunc = model_rvine_auto_trunc,
mixed_auto_trunc = model_mixed_auto_trunc,
dvine_auto_trunc = model_dvine_auto_trunc
),
criteria = criteria,
trunc_levels = trunc_levels,
best_model = best_model,
simulated_data = simulated_data
))
}
results <- exemple_complet_rvine()
###########################################################################################
# Fichier contenant les fonctions d'optimisation à utiliser pour calculer les pondération #
###########################################################################################
rm(list = ls())
# Load the package
library(PortfolioAnalytics)
library(CVXR)
library(MASS)
# A noter : Rendements à retraiter avant d'utiliser ces méthodes ===> renvoient le vecteur de poids pour un ensemble de rendements valides
# A flexibiliser pour accueillir plusieurs dist
VaR <- function(returns, w, alpha, value = 100){
# Calcul du rendement moyen par actif
mu <- colMeans(returns)
sigma <- cov(returns)
# Calcul des moments de la distribution des rendements
ret <- mu %*% t(w)
matcov <- quad_form(w, sigma)
# Tirage depuis la distribution des rendements pour le quantile alpha donné et calcul de la VaR
print("To be implemented")
var_ptf <- qnorm(alpha, mean = ret, sd = sqrt(matcov))
return (var_ptf)
}
# Toutes les optims à revoir (==> Ajouter VaR + pb sur les optims qui font intervenir la CVaR comme mesure de risque, optimisation sans limite)
# Portefeuille MaxSharpe
maxSharpe2 <- function(returns, u0){
# Fonction permettant de réaliser une optimisation min-variance
# Inputs :
# returns => vecteur de rendements à utiliser
# u0 => cible de rendement à atteindre
# v => paramtètre de scaling
# output : poids
# Récupération du nombre d'actif
returns <- as.matrix(returns)
n_asset <- ncol(returns)
# Création de la variable à optimiser (poids)
w <- Variable(n_asset)
v <- Variable(1)
# Calcul du rendement annualisé moyen de chaque titre (vecteur colonne)
mu <- colMeans(returns)
print(mu)
# Calcul de la matrice de variance-covariance du portefeuille
sigma <- cov(returns)
print(sigma)
# Calcul des mesures de rendement / risque du portefeuille annualisés
ret <- t(mu) %*% w
risk <- quad_form(w, sigma)
print(risk)
# Ajout des contraintes : full inv, pas de short, rendement sup à la cible
constraints <- list(w >= 0, sum(w) == v, ret >= u0)
# Définition de la fonction objectif
objective <- risk
# Résolution du problème
prob <- Problem(Minimize(objective), constraints)
result <- solve(prob)
# Affichage des résultats
print(result)
# Affichage du rendement et du risque du portefeuille
print(" ")
print("Affichage du rendement et du risque : ")
print(result$getValue(ret))
print(result$getValue(risk))
# Récupération des poids optimaux scalé
opt_weights = result$getValue(w) / result$getValue(v)
return(opt_weights)
}
# Portefeuille Min CVaR
minCVaR <- function(returns, alpha){
# Fonction permettant de minimiser la CVaR d'un portefeuille d'après la méthode de Rockafellar & Uryasev (2000)
# Input :
# returns => matrice contenant les rendements des actifs
# alpha => quantile pour le calcul de la CVaR
# Output : résultat de l'optimisation
# Récupération des informations sur les dimensions
returns <- as.matrix(returns)
M <- nrow(returns)
d <- ncol(returns)
# Création des variables
w <- Variable(d)
v <- Variable(M)
l <- Variable(1)
# Calcul du rendement moyen et de la matrice de variance-covariance des actifs
mu <- colMeans(returns)
sigma <- cov(returns)
print(sigma)
# Calcul des métriques du portefeuille : rendement moyen et risque
ret <-t(mu) %*% w
risk <- quad_form(w, sigma)
# Affichage du rendement et du risque
print(ret@lh_exp@value)
print(risk@P@value)
# Contrainte à ajouter : l = VaR (alpha), voir comment l'ajouter (distribution ...)
# l == qnorm(alpha, mean = ret@lh_exp@value, sd = sqrt(risk@P@value))
# Problème : minimisation de la CVaR
prob <- Problem(Minimize(l + 1/(M*(1-alpha)) * sum(v)),
constraints = list(
v >= -t(w)%*%mu - l,
w >= 0,
sum(w)==1,
v >= 0))
result <- solve(prob)
# Affichage des résultats
print(result)
return(as.vector(result$getValue(w)))
}
# Portefeuille Max STARR
maxStarr <- function(returns, alpha, u0){
# Portefeuille qui permet de maximiser le ratio STARR
# Input :
# returns => matrice contenant les rendements des actifs
# alpha => quantile pour le calcul de la CVaR
# Output : résultat de l'optimisation
# Récupération des informations sur les dimensions
returns <- as.matrix(returns)
M <- nrow(returns)
d <- ncol(returns)
# Création des variables
w <- Variable(d)
vt <- Variable(M)
l <- Variable(1)
v <- Variable(1)
# Calcul des rendements moyen et matrice de var-cov des actifs
mu <- colMeans(returns)
sigma <- cov(returns)
# Calcul des métriques du portefeuille : rendement moyen et risque
ret <-t(mu) %*% w
risk <- quad_form(w, sigma)
# Ajouter la contrainte sur la VaR
# l == qnorm(alpha, mean = ret, sd = sqrt(risk))
# Problème : minimisation de la CVaR
prob <- Problem(Minimize(l + 1/(M*(1-alpha)) * sum(v)),
constraints = list(ret >= u0,
vt >= -returns%*%w - l,
w >= 0,
sum(w)==v,
vt >= 0,
v >= 0))
result <- solve(prob)
# Affichage des résultats
print("Résultats de l'optimisation")
print(result)
return(as.vector(result$getValue(w)/result$getValue(v)))
}
# Portefeuille Max Sharpe contraint
maxSharpeConst <- function(returns, alpha, u0, ubound){
# Fonction permettant de construire un portefeuille Max Sharpe en contraignant le niveau de CVaR du portefeuille
# Inputs :
# returns : matrice de rendements à utiliser
# alpha : seuil pour la CVaR
# u0 : seuil de performance à atteindre
# ubound : niveau de CVaR maximal
# Récupération des dimensions sur les rendements
returns <- as.matrix(returns)
M <- nrow(returns)
d <- ncol(returns)
# Création des variables utilisées dans l'optimisation
w <- Variable(d)
l <- Variable(1)
vt <- Variable(M)
v <- Variable(1)
# Calcul des moments des rendements
mu <- colMeans(returns)
sigma <- cov(returns)
# Calcul de la VaR (à voir)
# Calcul des métriques de rendement et de risque du portefeuille
ptf_ret <- t(mu) %*% w
ptf_risk <- quad_form(w, sigma)
ptf_cvar <- l + 1/(M*(1-alpha)) * sum(vt)
# Définition de la fonction objectif : risque du ptf
objective <- ptf_risk
# Définition des contraintes
constraints <- list(ptf_ret >= u0,
ptf_cvar <= ubound,
vt >= -returns %*% w - l,
sum(w) == v,
w >= 0,
vt >= 0,
v >= 0)
# Résolution du programme d'optimisation
problem_opt <- Problem(Minimize(objective), constraints)
result <- solve(problem_opt)
# Affichage des résultats de l'optimisation
print(result)
# Récupération des poids scalés
return(as.vector(result$getValue(w)/result$getValue(v)))
}
# Portefeuille Max STARR contraint
maxStarrConst <- function(returns, alpha, u0, ubound){
# Fonction permettant de construire un portefeuille Max STARR en contraignant le niveau de CVaR
# Inputs :
# returns : matrice de rendements à utiliser
# alpha : seuil pour la CVaR
# u0 : seuil de performance à atteindre
# ubound : niveau de CVaR maximal
# Récupération des dimensions sur les rendements
returns <- as.matrix(returns)
M <- nrow(returns)
d <- ncol(returns)
# Création des variables utilisées dans l'optimisation
w <- Variable(d)
l <- Variable(1)
vt <- Variable(M)
v <- Variable(1)
# Calcul des moments des rendements
mu <- colMeans(returns)
sigma <- cov(returns)
# Calcul de la VaR (à voir)
# Calcul des métriques de rendement et de risque du portefeuille
ptf_ret <- t(mu) %*% w
ptf_risk <- l + 1/(M*(1-alpha)) * sum(vt)
# Définition de la fonction objectif : risque du ptf
objective <- ptf_risk
# Définition des contraintes
constraints <- list(ptf_ret >= u0,
ptf_risk <= ubound,
vt >= -returns %*% w - l,
sum(w) == v,
w >= 0,
vt >= 0,
v >= 0) # inégalité stricte pas implémentée donc large...
# Résolution du programme d'optimisation
problem_opt <- Problem(Minimize(objective), constraints)
result <- solve(problem_opt)
# Affichage des résultats de l'optimisation
print(result)
# Récupération des poids scalés
return(as.vector(result$getValue(w)/result$getValue(v)))
}
# Portefeuille Mean CVaR
meanCVaR <- function(returns, alpha, cvar0){
# Fonction permettant de calculer les poids optimaux pour un portefeuille Mean CVaR
# Input :
# returns : matrice de rendement
# alpha : seuil pour le calcul de CVaR
# cvar0 !: seuil max de CVaR
# Récupération des rendements et des dimensions
returns <- as.matrix(returns)
M <- nrow(returns)
d <- ncol(returns)
# Création des variables utilisées dans l'optimisation
w <- Variable(d)
l <- Variable(1)
vt <- Variable(M)
v <- Variable(1)
# Calcul des rendements moytens et de la matrice de variance-covariance des rendements
mu <- colMeans(returns)
sigma <- cov(returns)
# Définition des mesures de performances et de risque (+ calcul de VaR à avoir)
ptf_ret <- t(mu) %*% w
ptf_cvar <- l + 1/(M*(1-alpha)) * sum(vt)
# Définition de la fonction objectif
objective <- ptf_ret
# Définition des contraintes
constraints <- list(ptf_cvar <= cvar0,
sum(w) == v,
vt >= -returns %*% w - l,
w >= 0,
vt >= 0,
v >= 0)
# Optimisation
problem_ptf <- Problem(Maximize(objective), constraints)
result <- solve(problem_ptf)
# Affichage des résultats et récupération des valeurs
print(result)
return(as.vector(result$getValue(w)/result$getValue(v)))
}
# Exemple avec portfolio analytics (pour vérifier les résultats)
gmv <- function(returns){
# Fonction permettant de réaliser une optimisation min-variance
# inputs : vecteur de rendements à utiliser
# output : poids
# Print the head of the data
print(head(returns))
# Création du portefeuille
pspec <- portfolio.spec(colnames(returns))
# Ajout d'une contrainte : somme des poids égale à 1
pspec <- add.constraint(portfolio = pspec, type="full_investment")
# Ajout d'une contrainte: long only
pspec <- add.constraint(portfolio = pspec, type="long_only")
# Fonction objectif : minimisation de l'écart-type
pspec <- add.objective(portfolio = pspec, type="risk", name="StdDev")
# résolution
opt <- optimize.portfolio(returns, portfolio = pspec, optimize_method = "ROI")
# Affichage des résultats et récupération des poids optimaux
print(opt)
weights = extractWeights(opt)
return(weights)
}
